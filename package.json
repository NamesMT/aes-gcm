{
  "name": "@namesmt/aes-gcm",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Dead simple cross-platform AES-GCM encryption util package.",
  "author": "NamesMT <dangquoctrung123@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/namesmt",
  "homepage": "https://github.com/namesmt/aes-gcm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namesmt/aes-gcm.git"
  },
  "bugs": "https://github.com/namesmt/aes-gcm/issues",
  "keywords": [
    "AES",
    "GCM",
    "AES-GCM",
    "crypto",
    "encrypt",
    "encryption",
    "decrypt",
    "decryption"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "source": "./src/index.ts",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.13.1"
  },
  "scripts": {
    "start": "NODE_ENV=dev tsx src/index.ts",
    "watch": "NODE_ENV=dev tsx watch src/index.ts",
    "stub": "unbuild --stub",
    "dev": "pnpm run watch",
    "play": "pnpm run stub && pnpm run --filter playground dev",
    "play:useBuild": "pnpm run build && pnpm run --filter playground dev",
    "lint": "eslint .",
    "test": "vitest",
    "test:types": "tsc --noEmit --skipLibCheck",
    "check": "pnpm lint && pnpm test:types && vitest run --coverage",
    "build": "unbuild",
    "release": "pnpm dlx changelogen@latest --release --push --publish",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "uint8array-extras": "^1.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@namesmt/utils": "^0.5.18",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "hasown": "npm:@nolyfill/hasown@^1.0.44",
      "is-core-module": "npm:@nolyfill/is-core-module@^1.0.39"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
